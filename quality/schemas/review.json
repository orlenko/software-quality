{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Software Quality review v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol": {
      "const": "recorded-v1"
    },
    "context": {
      "$ref": "common.json#/$defs/context"
    },
    "reviews": {
      "type": "array",
      "items": {},
      "minItems": 0,
      "maxItems": 32
    }
  },
  "required": [
    "schema_version",
    "protocol",
    "context",
    "reviews"
  ],
  "additionalProperties": false
}
