{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "external-state schema2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "engine_version": {
      "const": "0.2.2"
    },
    "plan_id": {
      "type": "string",
      "pattern": "[0-9a-f]{32}"
    },
    "challenge": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "context": {
      "$ref": "external-common.json#/$defs/context"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "registry": {
      "$ref": "external-config.json"
    },
    "issued_wall_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "issued_mono_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "original": {
      "type": "array",
      "items": {
        "$ref": "external-common.json#/$defs/entry"
      },
      "minItems": 0,
      "maxItems": 1
    },
    "failure": {
      "type": "array",
      "items": {
        "$ref": "external-common.json#/$defs/entry"
      },
      "minItems": 0,
      "maxItems": 1
    },
    "observer": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "receipt_sha256": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          },
          "document": {
            "$ref": "external-observer.json"
          },
          "accepted_at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "accepted_at_mono_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "receipt_sha256",
          "document",
          "accepted_at_ms",
          "accepted_at_mono_ms"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1
    },
    "integrity_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "minItems": 0,
      "maxItems": 16
    },
    "request_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "minItems": 0,
      "maxItems": 16
    },
    "report": {
      "$ref": "external-report.json"
    },
    "state_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "issued": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "engine_version",
    "plan_id",
    "challenge",
    "context",
    "context_sha256",
    "registry",
    "issued_wall_ms",
    "issued_mono_ms",
    "original",
    "failure",
    "observer",
    "integrity_gaps",
    "request_gaps",
    "report",
    "state_sha256",
    "issued"
  ],
  "additionalProperties": false
}
