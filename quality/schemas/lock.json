{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Software Quality lock v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "publisher": {
      "const": "orlenko/software-quality"
    },
    "source": {
      "type": "string",
      "pattern": "(?:[0-9a-f]{40}|[0-9a-f]{64})"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "version": {
      "const": "0.1.2"
    },
    "policy_version": {
      "const": "0.1"
    }
  },
  "required": [
    "schema_version",
    "publisher",
    "source",
    "artifact_sha256",
    "version",
    "policy_version"
  ],
  "additionalProperties": false
}
