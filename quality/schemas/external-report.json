{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "external-report schema2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "engine_version": {
      "const": "0.2.1"
    },
    "policy_version": {
      "const": "0.1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "[0-9a-f]{32}"
    },
    "context": {
      "$ref": "external-common.json#/$defs/context"
    },
    "evidence_kind": {
      "const": "external-attestation"
    },
    "observed_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "external-common.json#/$defs/stage"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "overall": {
      "enum": [
        "pass",
        "fail",
        "incomplete"
      ]
    },
    "original_receipt_sha256": {
      "type": "string",
      "minLength": 0,
      "maxLength": 64
    },
    "failure_receipt_sha256": {
      "type": "string",
      "minLength": 0,
      "maxLength": 64
    },
    "observer_receipt_sha256": {
      "type": "string",
      "minLength": 0,
      "maxLength": 64
    }
  },
  "required": [
    "schema_version",
    "engine_version",
    "policy_version",
    "plan_id",
    "context",
    "evidence_kind",
    "observed_at_ms",
    "stages",
    "overall",
    "original_receipt_sha256",
    "failure_receipt_sha256",
    "observer_receipt_sha256"
  ],
  "additionalProperties": false
}
